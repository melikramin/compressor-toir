# --- Источник: платформа Compressor ---
API_BASE=https://com.geotek.app/api
# Ключ выдаёт admin в UI платформы: «Настройки → 1С:ТОиР → API-ключи».
API_KEY=
# Период опроса, секунд. В 1С «Период получения данных» ставить не чаще этого.
SYNC_INTERVAL=300

# --- Локальный Postgres (контейнер этого проекта) ---
POSTGRES_USER=toir
POSTGRES_PASSWORD=
POSTGRES_DB=toir
# Куда публикуем порт.
# 0.0.0.0 — 1С подключается с других машин: из сети или через интернет.
# 127.0.0.1 — 1С стоит на этом же сервере, снаружи порт не виден.
# При 0.0.0.0 защита только паролем: если у 1С постоянный IP, ограничьте
# доступ файрволом (ufw allow from IP_1C to any port 5432 proto tcp).
PG_BIND=0.0.0.0
PG_PORT=5432

# --- Read-only роль, под которой подключается 1С ---
# Создаётся и синхронизируется службой при каждом старте.
TOIR_1C_USER=toir_1c
TOIR_1C_PASSWORD=
