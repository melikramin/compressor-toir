# --- Источник: платформа Compressor ---
API_BASE=https://com.geotek.app/api
# Ключ выдаёт admin в UI платформы: «Настройки → 1С:ТОиР → API-ключи».
API_KEY=
# Период опроса, секунд. В 1С «Период получения данных» ставить не чаще этого.
SYNC_INTERVAL=300

# --- Локальный Postgres (контейнер этого проекта) ---
POSTGRES_USER=toir
POSTGRES_PASSWORD=
POSTGRES_DB=toir
# Куда публикуем порт. 127.0.0.1 — 1С на этой же машине.
# 0.0.0.0 — 1С на другой машине в локальной сети. В интернет не выставлять.
PG_BIND=127.0.0.1
PG_PORT=5432

# --- Read-only роль, под которой подключается 1С ---
# Создаётся и синхронизируется службой при каждом старте.
TOIR_1C_USER=toir_1c
TOIR_1C_PASSWORD=
